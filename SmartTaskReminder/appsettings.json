{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }

    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss}] [{Level:u3}] {Message:lj}{NewLine}{Exception}{NewLine}"

        }
      }
    ],
    "Enrich": [ "FromLogContext" ]

  },
  "AllowedHosts": "*",
  "JWT": {
    "SecretKey": "c708bd17795c94b283sccdddsa91d8f76ce5eehhk90",
    "Issuer": "SecureApi",
    "Audience": "SecureApiUser",
    "validateAudience": true,
    "validateIssuer": true,
    "validateLifetime": true,
    "validateIssuerSigningKey": true,
    "AccessTokenExpireMinute": 15,
    "RefreshTokenExpireDay": 7

  },
  "SeedAdmin": {
    "Email": "admin@gmail.com",
    "UserName": "admin",
    "Password": "123?AAa"
  }
}
